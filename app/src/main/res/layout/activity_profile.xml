<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Profile"
    android:background="@drawable/untitleddesignh">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/materialToolbar"
        android:layout_width="413dp"
        android:layout_height="58dp"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="0dp"
        tools:ignore="MissingConstraints,VisualLintBounds">
        <!-- Back Button -->
        <ImageButton
            android:id="@+id/button090"
            android:layout_width="@dimen/dim_67"
            android:layout_height="@dimen/dim_69"
            android:background="@null"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription,ImageContrastCheck,MissingConstraints,SpeakableTextPresentCheck,TouchTargetSizeCheck,VisualLintBounds"
            tools:layout_editor_absoluteY="@dimen/dim_3"
            android:src="@drawable/baseline_arrow_back_ios_24"
            app:tint="@android:color/white"
            />
    </com.google.android.material.appbar.MaterialToolbar>
    <!-- Profile Card -->
    <!-- Profile Card with Glassmorphism Effect (Centered) -->
    <androidx.cardview.widget.CardView
        android:layout_width="323dp"
        android:layout_height="531dp"
        android:layout_margin="@dimen/dim_20"
        android:background="@drawable/glass_card"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/materialToolbar"
        app:layout_constraintVertical_bias="0.621">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_gravity="center"     >
            <!-- Profile Image (Fetched from Firebase) -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:elevation="10dp"
                >
                <!-- Profile Image with Border & Shadow -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/i"
                    app:strokeWidth="4dp"
                    android:background="@drawable/profile_image_border"
                    app:shapeAppearanceOverlay="@style/CircleImageViewTwo"
                    android:elevation="10dp"
                    android:layout_gravity="center"/>

                <!-- Overlay View for Stylish Effect -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.3"

                    android:background="@drawable/overlay_effect" />
            </FrameLayout>
            <!-- Name -->
            <TextView
                android:id="@+id/mName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="4dp"/>


            <!-- Email -->
            <TextView
                android:paddingTop="16dp"
                android:id="@+id/mEmail2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <!-- Logout Button (Modern UI) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/LoginBtn2"
                android:layout_width="203dp"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_button"
                android:elevation="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:shadowColor="@color/black"
                android:text="@string/logout"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/red"
                app:cornerRadius="24dp"
                app:rippleColor="@color/buttonRipple" />


        </LinearLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>
