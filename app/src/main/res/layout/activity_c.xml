<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    tools:context=".C">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/todo78"
        android:scaleType="centerCrop"
        android:src="@drawable/untitleddesignh"
        tools:ignore="ImageContrastCheck" />

    <ImageButton
        android:id="@+id/button7690"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:background="@null"
        android:src="@drawable/baseline_arrow_back_24"

        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        tools:ignore="ContentDescription,ImageContrastCheck,MissingConstraints,SpeakableTextPresentCheck,TouchTargetSizeCheck"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView789"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/button7690"
        android:layout_marginTop="10dp"
        tools:ignore="MissingConstraints" />

</RelativeLayout>
